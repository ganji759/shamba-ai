{
  "name": "shamba-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Shamba AI offline PWA: crop-health checks in the browser with the ExecuTorch Wasm runtime",
  "license": "Apache-2.0",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
